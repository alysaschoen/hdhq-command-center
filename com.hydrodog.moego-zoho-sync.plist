<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nightly MoeGo -> Zoho Analytics sync (HDHQ Operations). Install:
         cp com.hydrodog.moego-zoho-sync.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.hydrodog.moego-zoho-sync.plist
       Runs at 04:30 local time; if the Mac was asleep, launchd runs it at next wake. -->
  <key>Label</key><string>com.hydrodog.moego-zoho-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alysaschoenfelder/moego-zoho/run_sync.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/alysaschoenfelder/moego-zoho</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/alysaschoenfelder/moego-zoho/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/alysaschoenfelder/moego-zoho/logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
