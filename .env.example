# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# --- Zoho OAuth ---
# Create a "Self Client" (or server-based client) at https://api-console.zoho.com,
# then generate a refresh token with the ZohoAnalytics.data.* + .modeling scopes.
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=1000.your_refresh_token_here

# --- Zoho Analytics ---
# Org ID: Analytics > Settings > gear icon (a.k.a. ZANALYTICS-ORGID).
ZOHO_ORG_ID=00000000000
# Workspace (database) ID: from the workspace URL after logging in.
ZOHO_WORKSPACE_ID=00000000000

# --- Data centre endpoints (change only if your account lives outside .com) ---
# US: .com   EU: .eu   India: .in   Australia: .com.au   China: .com.cn   Japan: .jp
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ANALYTICS_URL=https://analyticsapi.zoho.com

# --- Test script only ---
# Name of the throwaway table the test script creates/loads into.
ZOHO_TEST_TABLE_NAME=zz_sync_smoke_test
# If you already have a table, set its view ID here to skip auto-create.
# ZOHO_TEST_VIEW_ID=

# --- MoeGo Open API (Enterprise; one company, one business per location) ---
# Base64-encoded MoeGo API key (as given in the Postman collection variables).
MOEGO_API_KEY_B64=
# Optional: leave blank and the sync discovers them via companies:list / businesses:list.
MOEGO_COMPANY_ID=
MOEGO_BUSINESS_IDS=

# --- One-time Zoho OAuth bootstrap ---
# Paste the Self Client "grant code" here once; `python zoho_auth.py` swaps it for
# ZOHO_REFRESH_TOKEN above and blanks this line.
ZOHO_GRANT_CODE=
